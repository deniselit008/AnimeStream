{
  "name": "animestream-node",
  "version": "1.1.0",
  "description": "AnimeStream - Agregador y Reproductor de Anime en Tiempo Real en Node.js y Electron",
  "main": "electron/main.js",
  "scripts": {
    "start": "node run.js",
    "electron": "electron electron/main.js",
    "dev": "node --watch run.js",
    "server": "node server/index.js",
    "build:win": "electron-builder --win --x64",
    "build:portable": "electron-builder --win portable --x64",
    "build:linux": "electron-builder --linux AppImage deb --x64",
    "build:all": "electron-builder --win --linux",
    "export:all": "node scripts/export-all.js"
  },
  "keywords": [
    "anime",
    "streaming",
    "aggregator",
    "electron",
    "nodejs"
  ],
  "author": "AnimeStream <deniselit008@github.com>",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.21.0",
    "cheerio": "^1.2.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "fast-xml-parser": "^5.12.0",
    "multer": "^2.5.0",
    "open": "^11.0.4"
  },
  "devDependencies": {
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.animestream.app",
    "productName": "AnimeStream",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "server/**/*",
      "public/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AnimeStream"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo",
      "maintainer": "AnimeStream <deniselit008@github.com>"
    }
  }
}
